module

public import BlokDichotomy.GeneralFrame.Basic
public import BlokDichotomy.Kripke.Correspondence
public import Mathlib.Order.Preorder.Finite

/-!
# General frames on preorders

Upsets and implication sets of a preordered frame, the admissible upsets of a general frame, the
Boolean algebra generated by a family of upsets that is closed under the Heyting operations, and the
points outside such a Boolean combination from which one never re-enters it.

## References

- [CZ98, §8.1, §8.3]
-/

@[expose] public section

universe u v

variable {κ : Type u} {α : Type v}

/-- `X` is an upset: `x ≺ y` and `x ∈ X` imply `y ∈ X`. -/
def Frame.IsUpset (F : Frame κ) (X : Set F.World) : Prop :=
  ∀ ⦃x y : F.World⦄, x ≺ y → x ∈ X → y ∈ X

/-- The set of points all of whose successors in `X` lie in `Y`. -/
def Frame.himpSet (F : Frame κ) (X Y : Set F.World) : Set F.World :=
  {x | ∀ y, x ≺ y → y ∈ X → y ∈ Y}

namespace Frame

variable {F : Frame κ} {X Y : Set F.World}

lemma himpSet_eq_boxSet : F.himpSet X Y = F.boxSet (Xᶜ ∪ Y) := by
  ext w;
  simp only [himpSet, boxSet, Set.mem_ofPred_eq, Set.mem_union, Set.mem_compl_iff];
  grind;

lemma diaSet_diff_eq : F.diaSet (X \ Y) = (F.himpSet X Y)ᶜ := by
  ext w;
  simp only [diaSet, himpSet, Set.mem_ofPred_eq, Set.mem_sdiff, Set.mem_compl_iff];
  grind;

section

variable [IsPreorder κ F.Rel]

lemma boxSet_subset (X : Set F.World) : F.boxSet X ⊆ X :=
  fun w hw => hw w <| rel_refl w

lemma IsUpset.boxSet_eq (h : F.IsUpset X) : F.boxSet X = X := by
  apply Set.Subset.antisymm (boxSet_subset X);
  intro w hw v Rwv;
  exact h Rwv hw

lemma isUpset_boxSet (X : Set F.World) : F.IsUpset (F.boxSet X) :=
  fun _ _ Rxy hx v Ryv => hx v <| rel_trans Rxy Ryv

end

lemma IsUpset.inter (hX : F.IsUpset X) (hY : F.IsUpset Y) : F.IsUpset (X ∩ Y) :=
  fun _ _ Rxy hx => ⟨hX Rxy hx.1, hY Rxy hx.2⟩

lemma IsUpset.union (hX : F.IsUpset X) (hY : F.IsUpset Y) : F.IsUpset (X ∪ Y) :=
  fun _ _ Rxy hx => hx.imp (hX Rxy) (hY Rxy)

lemma isUpset_empty : F.IsUpset (∅ : Set F.World) := fun _ _ _ hx => hx.elim

end Frame

namespace GeneralFrame

variable {G : GeneralFrame κ} {X Y : Set G.World}

/-- The admissible upsets of `G`. -/
def upAdm (G : GeneralFrame κ) : Set (Set G.World) := {X ∈ G.Adm | G.toFrame.IsUpset X}

lemma upAdm_subset_adm : G.upAdm ⊆ G.Adm := fun _ hX => hX.1

lemma validates_logicS4 [IsPreorder κ G.Rel] : G ⊧ (𝐒𝟒 : NormalLogic α) := by
  intro A hA;
  exact validates_of_toFrame <| Frame.validates_logicS4 A hA;

section

variable [IsPreorder κ G.Rel]

lemma boxSet_mem_upAdm (hX : X ∈ G.Adm) : G.toFrame.boxSet X ∈ G.upAdm :=
  ⟨boxSet_mem hX, Frame.isUpset_boxSet X⟩

lemma himpSet_mem_upAdm (hX : X ∈ G.Adm) (hY : Y ∈ G.Adm) : G.toFrame.himpSet X Y ∈ G.upAdm := by
  rw [Frame.himpSet_eq_boxSet];
  exact boxSet_mem_upAdm <| himp_mem hX hY

end

end GeneralFrame

section BoolClosure

open BooleanSubalgebra

variable {F : Frame κ} {𝒜 : Set (Set F.World)} {X : Set F.World}

lemma Frame.univ_mem_of_himp (hhimp : ∀ {Y Z : Set F.World}, Y ∈ 𝒜 → Z ∈ 𝒜 → F.himpSet Y Z ∈ 𝒜)
    (hempty : ∅ ∈ 𝒜) : Set.univ ∈ 𝒜 := by
  simpa [Frame.himpSet] using hhimp hempty hempty

lemma Frame.diaSet_mem_closure (hsub : IsSublattice 𝒜)
    (hhimp : ∀ {Y Z : Set F.World}, Y ∈ 𝒜 → Z ∈ 𝒜 → F.himpSet Y Z ∈ 𝒜) (hempty : ∅ ∈ 𝒜)
    (hX : X ∈ closure 𝒜) : F.diaSet X ∈ closure 𝒜 := by
  have h₁ : ∀ Y ∈ 𝒜, ∀ Z ∈ 𝒜, F.diaSet (Y \ Z) ∈ closure 𝒜 := by
    intro Y hY Z hZ;
    rw [Frame.diaSet_diff_eq];
    exact compl_mem <| subset_closure <| hhimp hY hZ;
  have h₂ : ∀ Y Z, F.diaSet Y ∈ closure 𝒜 → F.diaSet Z ∈ closure 𝒜 →
      F.diaSet (Y ⊔ Z) ∈ closure 𝒜 := by
    intro Y Z hY hZ;
    change F.diaSet (Y ∪ Z) ∈ closure 𝒜;
    rw [Frame.diaSet_union];
    exact sup_mem hY hZ;
  exact closure_sdiff_sup_induction (p := fun Y _ => F.diaSet Y ∈ closure 𝒜) hsub hempty
    (Frame.univ_mem_of_himp hhimp hempty) h₁ (fun Y _ Z _ => h₂ Y Z) X hX

/-- An upset in the Boolean closure of a family of upsets belongs to the family. -/
lemma Frame.mem_of_isUpset_of_mem_closure [IsPreorder κ F.Rel] (hsub : IsSublattice 𝒜)
    (hhimp : ∀ {Y Z : Set F.World}, Y ∈ 𝒜 → Z ∈ 𝒜 → F.himpSet Y Z ∈ 𝒜) (hempty : ∅ ∈ 𝒜)
    (hX : X ∈ closure 𝒜) (hX' : F.IsUpset X) : X ∈ 𝒜 := by
  have h₁ : ∀ Y ∈ 𝒜, ∀ Z ∈ 𝒜, F.boxSet (Y \ Z)ᶜ ∈ 𝒜 := by
    intro Y hY Z hZ;
    have h : F.boxSet (Y \ Z)ᶜ = F.himpSet Y Z := by
      rw [Frame.himpSet_eq_boxSet, Set.compl_sdiff, Set.union_comm];
    rw [h];
    exact hhimp hY hZ;
  have h₂ : ∀ Y Z, F.boxSet Yᶜ ∈ 𝒜 → F.boxSet Zᶜ ∈ 𝒜 → F.boxSet (Y ⊔ Z)ᶜ ∈ 𝒜 := by
    intro Y Z hY hZ;
    change F.boxSet (Y ∪ Z)ᶜ ∈ 𝒜;
    rw [Set.compl_union, Frame.boxSet_inter];
    exact hsub.infClosed hY hZ;
  have h₃ : F.boxSet Xᶜᶜ ∈ 𝒜 :=
    closure_sdiff_sup_induction (p := fun Y _ => F.boxSet Yᶜ ∈ 𝒜) hsub hempty
      (Frame.univ_mem_of_himp hhimp hempty) h₁ (fun Y _ Z _ => h₂ Y Z) Xᶜ (compl_mem hX);
  rw [compl_compl, hX'.boxSet_eq] at h₃;
  exact h₃

end BoolClosure

section Signature

variable {F : Frame κ} {X : Set F.World}

/-- Above a point outside `X`, there is a point outside `X` from which one never re-enters `X`,
provided `X` is determined by finitely many upsets. -/
lemma Frame.exists_rel_not_mem_of_finset_determines [IsPreorder κ F.Rel]
    {𝒵 : Finset (Set F.World)} (h𝒵 : ∀ Z ∈ 𝒵, F.IsUpset Z)
    (hX : ∀ u v, (∀ Z ∈ 𝒵, u ∈ Z ↔ v ∈ Z) → (u ∈ X ↔ v ∈ X)) {x : F.World} (hx : x ∉ X) :
    ∃ z, x ≺ z ∧ z ∉ X ∧ ∀ u v, z ≺ u → u ≺ v → u ∈ X → v ∈ X := by
  classical
  let S : F.World → Finset (Set F.World) := fun u => 𝒵.filter (u ∈ ·)
  let P : Set F.World := {z | x ≺ z ∧ z ∉ X}
  have hS : ∀ u v, u ≺ v → S u ⊆ S v := by
    intro u v Ruv Z hZ;
    simp only [S, Finset.mem_filter] at hZ ⊢;
    exact ⟨hZ.1, h𝒵 Z hZ.1 Ruv hZ.2⟩;
  have hfin : (S '' P).Finite := by
    apply Set.Finite.subset (𝒵.powerset : Set (Finset (Set F.World))).toFinite;
    rintro _ ⟨z, -, rfl⟩;
    exact Finset.mem_coe.mpr <| Finset.mem_powerset.mpr <| Finset.filter_subset _ _;
  have hne : P.Nonempty := ⟨x, rel_refl x, hx⟩;
  obtain ⟨_, ⟨z, ⟨Rxz, hz⟩, rfl⟩, hmax⟩ := Set.Finite.exists_maximal hfin (hne.image S);
  use z;
  and_intros;
  · exact Rxz;
  · exact hz;
  · intro u v Rzu Ruv hu;
    by_contra hv;
    have h₁ : v ∈ P := ⟨rel_trans Rxz (rel_trans Rzu Ruv), hv⟩;
    have h₂ : S z ⊆ S u := hS z u Rzu;
    have h₃ : S u ⊆ S v := hS u v Ruv;
    have h₄ : S v ⊆ S z := hmax ⟨v, h₁, rfl⟩ (h₂.trans h₃);
    have h₅ : ∀ Z ∈ 𝒵, z ∈ Z ↔ u ∈ Z := by
      intro Z hZ;
      constructor;
      · exact fun h => h𝒵 Z hZ Rzu h;
      · intro h;
        have h₆ : Z ∈ S u := by simp [S, hZ, h];
        have h₇ : Z ∈ S z := h₄ (h₃ h₆);
        simpa [S] using (Finset.mem_filter.mp h₇).2;
    exact hz <| (hX z u h₅).mpr hu
