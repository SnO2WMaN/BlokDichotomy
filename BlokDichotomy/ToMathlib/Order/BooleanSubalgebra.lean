module

public import Mathlib.Order.BooleanSubalgebra
public import Mathlib.Data.Finset.Lattice.Fold
public import Mathlib.Data.Set.Finite.Lattice

/-!
# Finite intersections and unions in Boolean subalgebras of sets

Finite intersections and unions of members of a Boolean subalgebra of sets, and the finitely many
generators that determine an element of a generated Boolean subalgebra.
-/

@[expose] public section

namespace BooleanSubalgebra

variable {β γ : Type*} (L : BooleanSubalgebra (Set β)) (s : Finset γ) {P : γ → Set β}

/-- A Boolean subalgebra of sets contains the intersection of finitely many of its members. -/
lemma setOf_forall_mem (h : ∀ i ∈ s, P i ∈ L) : {x | ∀ i ∈ s, x ∈ P i} ∈ L := by
  have h₁ := Finset.inf_mem (L : Set (Set β)) L.top_mem (fun _ hx _ hy => L.inf_mem hx hy) s P h;
  have h₂ : s.inf P = {x | ∀ i ∈ s, x ∈ P i} := by
    ext x;
    simp [Finset.inf_set_eq_iInter];
  rw [h₂] at h₁;
  exact h₁

/-- A Boolean subalgebra of sets contains the union of finitely many of its members. -/
lemma setOf_exists_mem (h : ∀ i ∈ s, P i ∈ L) : {x | ∃ i ∈ s, x ∈ P i} ∈ L := by
  have h₁ := Finset.sup_mem (L : Set (Set β)) L.bot_mem (fun _ hx _ hy => L.sup_mem hx hy) s P h;
  have h₂ : s.sup P = {x | ∃ i ∈ s, x ∈ P i} := by
    ext x;
    simp [Finset.sup_set_eq_biUnion];
  rw [h₂] at h₁;
  exact h₁

/-- An element of the Boolean subalgebra of sets generated by `𝒜` is determined by finitely many
members of `𝒜`. -/
lemma exists_finset_determines {𝒜 : Set (Set β)} {X : Set β} (hX : X ∈ closure 𝒜) :
    ∃ 𝒵 : Finset (Set β), ↑𝒵 ⊆ 𝒜 ∧ ∀ u v, (∀ Z ∈ 𝒵, u ∈ Z ↔ v ∈ Z) → (u ∈ X ↔ v ∈ X) := by
  classical
  induction hX using closure_bot_sup_induction with
  | mem Y hY =>
    use {Y};
    and_intros;
    · simpa using hY;
    · simp;
  | bot =>
    use ∅;
    and_intros <;> simp;
  | sup Y _ Z _ ihY ihZ =>
    obtain ⟨𝒵₁, h₁, d₁⟩ := ihY;
    obtain ⟨𝒵₂, h₂, d₂⟩ := ihZ;
    use 𝒵₁ ∪ 𝒵₂;
    and_intros;
    · rw [Finset.coe_union];
      exact Set.union_subset h₁ h₂;
    · intro u v h;
      have e₁ := d₁ u v fun W hW => h W <| Finset.mem_union_left _ hW;
      have e₂ := d₂ u v fun W hW => h W <| Finset.mem_union_right _ hW;
      simp [e₁, e₂];
  | compl Y _ ih =>
    obtain ⟨𝒵, h₁, d⟩ := ih;
    use 𝒵;
    and_intros;
    · exact h₁;
    · intro u v h;
      simpa using not_congr (d u v h)

end BooleanSubalgebra

end
