module

public import BlokDichotomy.Kripke.Basic

/-!
# Point-generated subframes

The point-generated subframe `F⥜x` and submodel `M⥜x`, and preservation of truth and validity.

## References

- [CZ98, §3.3, Theorem 3.11]
-/

@[expose] public section

universe u v

variable {κ : Type u} {α : Type v}

namespace Frame

variable {F : Frame κ} {x y z : F.World} {n : ℕ}

def Reach (F : Frame κ) (x : F.World) : Set F.World := {y | x ≺^* y}

/-- `r` is a root of `F`: every point is reachable from `r`.
- [CZ98, §3.3] -/
def IsRootedBy (F : Frame κ) (r : F.World) : Prop := ∀ y : F.World, r ≺^* y

abbrev Root (F : Frame κ) := { r // F.IsRootedBy r }

@[simp, grind =] lemma mem_reach : y ∈ F.Reach x ↔ x ≺^* y := Iff.rfl

/-- If `x ≺ v` only for `v = x`, then `x` reaches only itself. -/
lemma eq_of_reflTransRel_of_forall_rel_eq (hsucc : ∀ v, x ≺ v → v = x) (h : x ≺^* y) :
    y = x := by
  obtain ⟨n, Rxy⟩ := h;
  induction n generalizing y with
  | zero => exact Rxy.symm;
  | succ n ih =>
    obtain ⟨z, Rxz, Rzy⟩ := iff_relItr_succ'.mp Rxy;
    rw [ih Rxz] at Rzy;
    exact hsucc y Rzy;

/-- The subframe generated by the point `x`.
- [CZ98, §3.3] -/
def pointGenerate (F : Frame κ) (x : F.World) : Frame (F.Reach x) := ⟨fun y z => y.1 ≺ z.1⟩
infix:60 "⥜" => pointGenerate

@[simp, grind =]
lemma pointGenerate_rel {y z : (F⥜x).World} : y ≺ z ↔ (y.1 ≺ z.1) := Iff.rfl

@[simp, grind =]
lemma pointGenerate_relItr {y z : (F⥜x).World} : (y ≺^[n] z) ↔ (y.1 ≺^[n] z.1) := by
  induction n generalizing y with
  | zero => simp [Subtype.ext_iff];
  | succ n ih =>
    rw [iff_relItr_succ, iff_relItr_succ];
    constructor;
    · rintro ⟨w, Ryw, Rwz⟩;
      exact ⟨w.1, Ryw, ih.mp Rwz⟩;
    · rintro ⟨w, Ryw, Rwz⟩;
      exact ⟨⟨w, ReflTransRel.tail y.2 Ryw⟩, Ryw, ih.mpr Rwz⟩;

def pointGenerate.root (F : Frame κ) (x : F.World) : (F⥜x).Root := ⟨⟨x, reflTransRel_refl x⟩, by
  rintro ⟨y, n, hn⟩;
  exact ⟨n, pointGenerate_relItr.mpr hn⟩
⟩

/-- `F` has a root.
- [CZ98, §3.3] -/
def IsRooted (F : Frame κ) := Nonempty F.Root

lemma isRooted_pointGenerate : (F⥜x).IsRooted := ⟨pointGenerate.root F x⟩

end Frame


namespace Model

variable {M : Model κ α} {x : M.World}

/-- The submodel generated by the point `x`.
- [CZ98, §3.3] -/
def pointGenerate (M : Model κ α) (x : M.World) : Model (M.Reach x) α where
  toFrame := M.toFrame⥜x
  Val' y a := M.Val y.1 a
infix:60 "⥜" => pointGenerate

@[simp] lemma pointGenerate_toFrame : (M⥜x).toFrame = M.toFrame⥜x := rfl

end Model


namespace Model.World

variable {M : Model κ α} {x : M.World} {φ : Formula α}

/-- `y ⊩ φ` in `M⥜x` iff `y.1 ⊩[M] φ`.
- [CZ98, Theorem 3.11] -/
@[grind =]
lemma forces_pointGenerate {y : (M⥜x).World} : y ⊩ φ ↔ y.1 ⊩[M] φ := by
  induction φ generalizing y with
  | falsum => simp;
  | atom a => rfl;
  | imp φ ψ ihφ ihψ => simp only [forces_imp, NotForces, ihφ, ihψ];
  | dia φ ih =>
    rw [forces_dia, forces_dia];
    constructor;
    · rintro ⟨z, Ryz, hz⟩;
      exact ⟨z.1, Ryz, ih.mp hz⟩;
    · rintro ⟨z, Ryz, hz⟩;
      exact ⟨⟨z, Frame.ReflTransRel.tail y.2 Ryz⟩, Ryz, ih.mpr hz⟩;

lemma forces_pointGenerate_root : Frame.pointGenerate.root M.toFrame x ⊩[M⥜x] φ ↔ x ⊩[M] φ :=
  forces_pointGenerate

lemma forces_congr_of_reach {V V' : κ → α → Prop}
    (hV : ∀ y : M.World, (x ≺^* y) → ∀ a, V y a ↔ V' y a) :
    x ⊩[⟨M.toFrame, V⟩] φ ↔ x ⊩[⟨M.toFrame, V'⟩] φ := by
  have h : Model.pointGenerate ⟨M.toFrame, V⟩ x = Model.pointGenerate ⟨M.toFrame, V'⟩ x := by
    simp only [Model.pointGenerate, Model.mk.injEq, true_and];
    funext y a;
    exact propext <| hV y.1 y.2 a;
  rw [← forces_pointGenerate_root (M := ⟨M.toFrame, V⟩),
    ← forces_pointGenerate_root (M := ⟨M.toFrame, V'⟩), h];

end Model.World


namespace Frame

variable {F : Frame κ} {x : F.World} {φ : Formula α} {L : NormalLogic α}

open Model.World

def pointGenerate.extendVal (V : F.Reach x → α → Prop) : κ → α → Prop :=
  fun w a => ∃ h : w ∈ F.Reach x, V ⟨w, h⟩ a

lemma pointGenerate.pointGenerate_extendVal (V : F.Reach x → α → Prop) :
    Model.pointGenerate ⟨F, pointGenerate.extendVal V⟩ x = ⟨F⥜x, V⟩ := by
  simp only [Model.pointGenerate, Model.mk.injEq, true_and];
  funext y a;
  exact propext ⟨fun ⟨_, h⟩ => h, fun h => ⟨y.2, h⟩⟩;

/-- If `F ⊧ φ`, then `F⥜x ⊧ φ`.
- [CZ98, Theorem 3.11] -/
lemma Validates.pointGenerate (h : F ⊧ φ) : F⥜x ⊧ φ := by
  intro V y;
  have := forces_pointGenerate (M := ⟨F, pointGenerate.extendVal V⟩) (φ := φ) (y := y);
  rw [pointGenerate.pointGenerate_extendVal] at this;
  exact this.mpr <| h _ _;

lemma ValidateLogic.pointGenerate (h : F ⊧ L) : F⥜x ⊧ L :=
  fun φ hA => Validates.pointGenerate <| h φ hA

/-- If `F⥜x ⊧ L` and `φ ∈ L`, then `x ⊩[⟨F, V⟩] φ` for every `V`. -/
lemma forces_of_pointGenerate_validateLogic (h : F⥜x ⊧ L) (hA : φ ∈ L) (V : F.World → α → Prop) :
    x ⊩[⟨F, V⟩] φ :=
  forces_pointGenerate_root.mp <| h φ hA _ _

/-- `F ⊧ φ` iff `F⥜x ⊧ φ` for every `x`.
- [CZ98, Theorem 3.11] -/
lemma validates_iff_forall_pointGenerate : F ⊧ φ ↔ ∀ x, F⥜x ⊧ φ := by
  constructor;
  · intro h x;
    exact h.pointGenerate;
  · intro h V x;
    exact forces_pointGenerate_root.mp <| h x _ _;

lemma validateLogic_iff_forall_pointGenerate : F ⊧ L ↔ ∀ x, F⥜x ⊧ L := by
  constructor;
  · intro h x;
    exact h.pointGenerate;
  · intro h φ hA;
    exact validates_iff_forall_pointGenerate.mpr fun x => h x φ hA;

lemma validates_iff_pointGenerate_of_root (r : F.Root) : F ⊧ φ ↔ F⥜r.1 ⊧ φ := by
  constructor;
  · exact Validates.pointGenerate;
  · intro h V x;
    have := forces_pointGenerate (M := ⟨F, V⟩) (x := r.1) (φ := φ) (y := ⟨x, r.2 x⟩);
    exact this.mp <| h _ _;

lemma validateLogic_iff_pointGenerate_of_root (r : F.Root) : F ⊧ L ↔ F⥜r.1 ⊧ L :=
  forall₂_congr fun _ _ => validates_iff_pointGenerate_of_root r

end Frame

end
